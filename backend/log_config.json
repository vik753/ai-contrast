{
  "version": 1,
  "disable_existing_loggers": false,
  "filters": {
    "exc_info_scrubber": {
      "()": "app.logging_filters.ExcInfoScrubber"
    }
  },
  "formatters": {
    "plain": {
      "format": "%(asctime)s %(levelname)s %(name)s %(message)s"
    }
  },
  "handlers": {
    "stderr": {
      "class": "logging.StreamHandler",
      "formatter": "plain",
      "stream": "ext://sys.stderr",
      "filters": [
        "exc_info_scrubber"
      ]
    }
  },
  "loggers": {
    "uvicorn": {
      "level": "INFO"
    },
    "uvicorn.access": {
      "level": "WARNING"
    },
    "httpx": {
      "level": "WARNING"
    },
    "httpcore": {
      "level": "WARNING"
    },
    "httpx2": {
      "level": "WARNING"
    },
    "httpcore2": {
      "level": "WARNING"
    }
  },
  "root": {
    "level": "INFO",
    "handlers": [
      "stderr"
    ]
  }
}
