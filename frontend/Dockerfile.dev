# Development image for the Vite dev server. Used only by docker-compose.yml.
# It copies no source: Compose bind-mounts ./frontend at /app and runs
# `npm ci --ignore-scripts` and `npm run dev` as the non-root `node` user.
#
# The base image is pinned by tag and multi-arch index digest; Dependabot (`docker`
# ecosystem, /frontend) updates the digest. Keep it in sync with the CI Node major.
FROM node:22-slim@sha256:c3de60bf2f9dd0ac6370e6117950ff62d6e339527e7472301c9c78a017978392

# Mount points owned by `node`. Docker copies this ownership into new named volumes
# (node_modules, the npm cache and the generated OCR assets in public/ocr), so the
# non-root user can write to them even when the bind-mounted checkout belongs to
# another uid (CI).
RUN mkdir -p /app/node_modules /app/public/ocr /home/node/.npm \
    && chown -R node:node /app /home/node/.npm

WORKDIR /app

USER node

EXPOSE 5173
