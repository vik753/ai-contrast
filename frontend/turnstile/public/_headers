# Cloudflare Pages response headers of the Turnstile frame project (second origin). Threat model T9.
# Changes to this file need security-reviewer approval.
# __APP_ORIGIN__ is replaced at deploy with the exact app origin (for example https://app.example.com).
/*
  Content-Security-Policy: default-src 'none'; script-src 'self' https://challenges.cloudflare.com; frame-src 'self' https://challenges.cloudflare.com; connect-src https://challenges.cloudflare.com; style-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors __APP_ORIGIN__; upgrade-insecure-requests
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
